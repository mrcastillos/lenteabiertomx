{
  "entities": {
    "Gallery": {
      "title": "Gallery",
      "description": "A photo collection or client event gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_@.\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 300 },
        "clientName": { "type": "string", "maxLength": 200 },
        "clientEmail": { "type": "string", "maxLength": 200 },
        "eventDate": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 250 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "coverPhotoUrl": { "type": "string", "minLength": 1, "maxLength": 900000 },
        "description": { "type": "string", "maxLength": 5000 },
        "accessPin": { "type": "string", "maxLength": 100 },
        "downloadPin": { "type": "string", "maxLength": 100 },
        "isPrivate": { "type": "boolean" },
        "driveFolderId": { "type": "string", "maxLength": 200 },
        "expiresAt": { "type": "string", "maxLength": 40 },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "coverPhotoUrl"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Global CMS content and theme appearance for Lente Abierto MX",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "galleriesInitialized": { "type": "boolean" },
        "appearance": { "type": "object" },
        "general": { "type": "object" },
        "hero": { "type": "object" },
        "announcement": { "type": "object" },
        "biography": { "type": "object" },
        "contact": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Booking and quote request from clients",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_@.\\-]+$" },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email": { "type": "string", "minLength": 1, "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 60 },
        "serviceType": { "type": "string", "maxLength": 150 },
        "eventDate": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 250 },
        "budgetRange": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "status": { "type": "string", "enum": ["nuevo", "contactado", "confirmado"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "clientName", "email", "message"]
    },
    "DownloadLog": {
      "title": "DownloadLog",
      "description": "Record of a gallery or single photo download",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_@.\\-]+$" },
        "galleryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "galleryTitle": { "type": "string", "maxLength": 300 },
        "photoId": { "type": "string", "maxLength": 200 },
        "photoTitle": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["single", "zip"] },
        "userName": { "type": "string", "maxLength": 200 },
        "userEmail": { "type": "string", "minLength": 1, "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 60 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "galleryId", "type", "userEmail"]
    },
    "FavoriteLog": {
      "title": "FavoriteLog",
      "description": "Record of a photo added to favorites",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_@.\\-]+$" },
        "galleryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "galleryTitle": { "type": "string", "maxLength": 300 },
        "photoId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "photoTitle": { "type": "string", "maxLength": 300 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "photoThumbnailUrl": { "type": "string", "maxLength": 2000 },
        "userName": { "type": "string", "maxLength": 200 },
        "userEmail": { "type": "string", "minLength": 1, "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 60 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "galleryId", "photoId", "userEmail"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with biography, contact and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_@.\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "type": "string", "enum": ["fotografo", "cliente", "admin", "colaborador", "asistente", "editor"] },
        "phone": { "type": "string", "maxLength": 60 },
        "whatsapp": { "type": "string", "maxLength": 60 },
        "instagram": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 1500 },
        "detailedBio": { "type": "string", "maxLength": 8000 },
        "avatarUrl": { "type": "string", "maxLength": 500000 }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "firestore": {
    "/galleries/{galleryId}": {
      "schema": "Gallery",
      "description": "Public and private photographic collections"
    },
    "/siteConfig/{configId}": {
      "schema": "SiteContent",
      "description": "Site configuration, theme, bio, and contact info"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Client quote inquiries"
    },
    "/downloadLogs/{logId}": {
      "schema": "DownloadLog",
      "description": "Audit log of client downloads"
    },
    "/favoriteLogs/{logId}": {
      "schema": "FavoriteLog",
      "description": "Audit log of favorited photos"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and credentials"
    }
  }
}
